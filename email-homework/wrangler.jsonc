{
	// The homework book's Homework 1 deploys this as-is. Later homeworks add the commented sections.
	"name": "email-homework",
	"main": "src/index.ts",
	// The newest date the bundled workerd supports; bump it when you bump wrangler.
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],

	// Homework 1: the address that routes to this Worker. Deploying creates the Email Routing rule
	// (Wrangler 4.113+). Use your own domain; an empty list [] removes the rules this Worker manages.
	// "addresses": ["bot@yourdomain.com"],

	"vars": {
		// The bot's own address: replies go out From this. Use the same address as in "addresses".
		// Cloudflare only lets the Worker reply as the domain that received the mail, so your personal
		// address fails with "mail from is not from the correct domain".
		"FROM_ADDRESS": "bot@example.com"
		// Homework 3: "MODEL": "claude-haiku-4-5-20251001", "ALLOWED_SENDERS": "you@example.com"
	},

	// Homework 3: secrets are NOT written here. Run: npx wrangler secret put ANTHROPIC_API_KEY

	// Homework 4: one Durable Object per sender.
	// "durable_objects": { "bindings": [{ "name": "AGENT", "class_name": "Agent" }] },
	// "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Agent"] }],

	// Homework 5: send mail on your own schedule. Free plan: only to your verified destination addresses.
	// "remote": true makes `wrangler dev` send real email.
	// "send_email": [{ "name": "EMAIL", "remote": true }],

	// Homework 8: uploads.
	// "r2_buckets": [{ "binding": "FILES", "bucket_name": "email-homework-files" }],
}
